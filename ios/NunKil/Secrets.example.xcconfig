// Copy to Secrets.xcconfig (gitignored) and fill in.
// xcconfig treats "//" as a comment, so URLs are written as http:/$()/host:port

// From Wearables Developer Center — register a separate app for this bundle ID
// (com.yangjongwon.nunkil) with the URL scheme nunkil://
META_APP_ID =
CLIENT_TOKEN =

// Apple Developer Team ID (Xcode > Signing & Capabilities).
DEVELOPMENT_TEAM =

// The machine running `uv run nunkil`, reachable from the iPhone on the same Wi-Fi.
BACKEND_URL = http:/$()/192.168.0.10:8010
// Must equal NUNKIL_TOKEN in the backend's .env
BACKEND_TOKEN =
